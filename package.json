{
  "name": "trading-training-assistant",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "check:env": "node scripts/check-environment.mjs",
    "start": "node server.mjs",
    "test": "npm run test:unit && npm run test:data",
    "test:unit": "node --test",
    "test:data": "node scripts/run-python-tests.mjs",
    "audit:market": "python3 -m tools.market_data.audit_market_db --database data/market.db",
    "test:e2e": "npm run test:e2e:api && npm run test:e2e:browser",
    "test:e2e:api": "node scripts/e2e-smoke.mjs",
    "test:e2e:browser": "node scripts/e2e-browser.mjs"
  },
  "engines": {
    "node": ">=22 <23"
  },
  "devDependencies": {
    "playwright": "^1.56.1"
  }
}
